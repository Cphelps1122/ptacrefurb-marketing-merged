const SHARED_SECRET = "CHANGE_ME_TO_A_PRIVATE_TOKEN";
const SPREADSHEET_ID = "PASTE_YOUR_GOOGLE_SHEET_ID_HERE";
function doGet(e){try{const p=e.parameter||{};const token=p.token||"";const action=p.action||"ping";if(action==="ping")return jsonResponse({status:"success",message:"PTAC Refurb Marketing OS bridge is live."});if(token!==SHARED_SECRET)return jsonResponse({status:"error",message:"Unauthorized request."});if(action==="read")return readSheet(p.sheet);return jsonResponse({status:"success",message:"PTAC Refurb Marketing OS bridge is live."});}catch(err){return jsonResponse({status:"error",message:err.toString()});}}
function doPost(e){try{const body=JSON.parse(e.postData.contents||"{}");if((body.token||"")!==SHARED_SECRET)return jsonResponse({status:"error",message:"Unauthorized request."});if(body.action==="append")return appendRow(body.sheet,body.row||{});return jsonResponse({status:"error",message:"Unknown POST action."});}catch(err){return jsonResponse({status:"error",message:err.toString()});}}
function readSheet(sheetName){if(!sheetName)return jsonResponse({status:"error",message:"Missing sheet name."});const ss=SpreadsheetApp.openById(SPREADSHEET_ID);const sh=ss.getSheetByName(sheetName);if(!sh)return jsonResponse({status:"error",message:"Sheet not found: "+sheetName});const values=sh.getDataRange().getDisplayValues();if(values.length<1)return jsonResponse({status:"success",rows:[]});const headers=values[0].map(h=>String(h).trim());const rows=[];for(let i=1;i<values.length;i++){const obj={};let has=false;for(let j=0;j<headers.length;j++){const key=headers[j];if(!key)continue;const val=values[i][j];obj[key]=val;if(String(val).trim()!=="")has=true;}if(has)rows.push(obj);}return jsonResponse({status:"success",rows:rows});}
function appendRow(sheetName,rowObject){if(!sheetName)return jsonResponse({status:"error",message:"Missing sheet name."});const ss=SpreadsheetApp.openById(SPREADSHEET_ID);const sh=ss.getSheetByName(sheetName);if(!sh)return jsonResponse({status:"error",message:"Sheet not found: "+sheetName});const headers=sh.getRange(1,1,1,sh.getLastColumn()).getDisplayValues()[0].map(h=>String(h).trim());const row=headers.map(h=>rowObject[h]!==undefined?rowObject[h]:"");sh.appendRow(row);return jsonResponse({status:"success",message:"Row appended."});}
function jsonResponse(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);}
